# ==============================================================================
# DZPRINT PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and provide your production credentials
# ==============================================================================

# Supabase Configuration (PostgreSQL Database, Auth & Storage)
# Required for persistent production database and file uploads
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Transactional Email (Resend)
# Required for real order notification emails to admin and confirmation emails to customers
RESEND_API_KEY=re_123456789...
ADMIN_EMAIL=orders@dzprint.dz
FROM_EMAIL=DZPrint <orders@resend.dev>

# Store Admin & Contact Information
ADMIN_SECRET=
NOTIFICATION_EMAIL=orders@dzprint.dz
WHATSAPP_NUMBER=+213550123456

# Application URL
APP_URL=https://your-app.vercel.app
